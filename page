<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Connexion – Comptes Google</title>
    
    <script src="https://google.com" async defer></script>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Roboto', arial, sans-serif;
        }

        body {
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            background-color: #f0f4f9;
        }

        .login-container {
            background: #ffffff;
            border-radius: 28px;
            padding: 40px;
            width: 100%;
            max-width: 448px;
            min-height: 500px;
            display: flex;
            flex-direction: column;
            align-content: space-between;
        }

        .header {
            text-align: center;
            margin-bottom: 32px;
        }

        .logo {
            height: 24px;
            margin-bottom: 16px;
        }

        h1 {
            color: #1f1f1f;
            font-size: 24px;
            font-weight: 400;
            line-height: 1.33;
            margin-bottom: 8px;
        }

        p.subtitle {
            color: #444746;
            font-size: 16px;
            font-weight: 400;
            letter-spacing: 0.1px;
            line-height: 1.5;
        }

        /* Conteneur d'intégration des boutons Google */
        .auth-actions {
            margin-top: 24px;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 16px;
            width: 100%;
        }

        /* Simulation visuelle du champ classique Google (optionnel si vous n'utilisez que le bouton standard) */
        .input-group {
            width: 100%;
            margin-bottom: 20px;
            position: relative;
        }

        .input-field {
            width: 100%;
            padding: 16px;
            border: 1px solid #747775;
            border-radius: 4px;
            font-size: 16px;
            outline: none;
            transition: border-color 0.2s;
        }

        .input-field:focus {
            border-color: #0b57d0;
            border-width: 2px;
            padding: 15px; /* Ajustement pour compenser la bordure de 2px */
        }

        .footer {
            margin-top: auto;
            display: flex;
            justify-content: space-between;
            font-size: 12px;
            color: #444746;
        }

        .footer a {
            color: #444746;
            text-decoration: none;
            margin-left: 16px;
        }

        .footer a:hover {
            text-decoration: underline;
        }
    </style>
</head>
<body>

    <div class="login-container">
        <div class="header">
            <!-- Logo officiel Google SVG -->
            <svg class="logo" viewBox="0 0 74 24" width="74" height="24" xmlns="http://w3.org">
                <path d="M12.25 4.75c1.76 0 3.35.61 4.6 1.8l3.43-3.43C18.2 1.19 15.44 0 12.25 0 7.47 0 3.33 2.74 1.33 6.75l4.03 3.13c.95-2.86 3.63-5.13 6.89-5.13z" fill="#EA4335"/>
                <path d="M23.32 12.25c0-.88-.08-1.73-.22-2.56H12.25v4.84h6.22c-.27 1.41-1.07 2.61-2.27 3.41v3.13h3.66c2.14-1.97 3.46-4.87 3.46-8.82z" fill="#4285F4"/>
                <path d="M5.36 14.12c-.25-.75-.4-1.55-.4-2.37s.14-1.62.4-2.37L1.33 6.75C.48 8.44 0 10.32 0 12.25s.48 3.81 1.33 5.5l4.03-3.63z" fill="#FBBC05"/>
                <path d="M12.25 24c3.31 0 6.08-1.1 8.11-2.97l-3.66-3.13c-1.01.68-2.31 1.08-4.45 1.08-3.26 0-5.94-2.27-6.92-5.13L1.3 17.02C3.31 21.24 7.44 24 12.25 24z" fill="#34A853"/>
            </svg>
            <h1>Connexion</h1>
            <p class="subtitle">Accéder à votre application</p>
        </div>

        
        <div class="auth-actions">
            
            <!-- 1. Initialisation de la connexion Google -->
            <div id="g_id_onload"
                 data-client_id="VOTRE_CLIENT_ID_://googleusercontent.com"
                 data-context="signin"
                 data-ux_mode="popup"
                 data-callback="handleCredentialResponse"
                 data-auto_prompt="false">
            </div>

            <!-- 2. Rendu du bouton officiel "Se connecter avec Google" -->
            <div class="g_id_signin"
                 data-type="standard"
                 data-shape="rectangular"
                 data-theme="outline"
                 data-text="signin_with"
                 data-size="large"
                 data-logo_alignment="left"
                 data-width="368">
            </div>
            
        </div>

        <div class="footer">
            <span>Français</span>
            <div>
                <a href="https://google.com" target="_blank">Aide</a>
                <a href="https://google.com" target="_blank">Confidentialité</a>
                <a href="https://google.com" target="_blank">Conditions</a>
            </div>
        </div>
    </div>

    <script>
        /**
         * Fonction de rappel (callback) appelée automatiquement après une connexion réussie
         * @param {Object} response - Contient le jeton JWT renvoyé par Google
         */
        function handleCredentialResponse(response) {
            console.log("Jeton d'authentification JWT reçu : ", response.credential);
            
            // Étape suivante standard : Envoyer le jeton (response.credential) à votre serveur backend 
            // via une requête HTTPS POST ou Fetch pour authentifier ou créer la session utilisateur.
            
            alert("Connexion réussie ! Jeton d'accès intercepté (voir la console).");
        }
    </script>
</body>
</html>
